tag this;
tag that;
taggroup those = this, that;

struct MetaData [this] {
    f1: int,
    f2: str,
};

struct Data [] {
    meta: MetaData,
    f2: str,
};

action read_data(Data) -> Data fallback deny;
action write_data(Data) -> Data fallback deny;
actiongroup all = read_data, write_data;

rules all(data: Data) {
    allow when data.meta.f1 > 4 and data.meta contains_all those;
    deny when "oasdn" matches `this that`;
    apply [those, that] always;
};

rules write_data(data: Data) {
    allow always;
    deny never;
};
