tag this;
tag that;
taggroup those = this, that;

struct MetaData [this] {
    f1: int,
    f2: str,
};

struct Data [] {
    meta: MetaData,
    f2: str,
};

action read_data(Data);
action do_nothing(Data);
actiongroup all = read_data, do_nothing;

rules all(data: Data) fallback deny {
    allow when data.meta.f1 > 4 and data.meta contains_all those;
    deny when "oasdn" matches `this that`;
    apply [those, that] always;
};

rules do_nothing(data: Data) fallback deny {
    allow always;
    deny never;
};
